{
  "name": "drt",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "setup:backend": "node scripts/venv-python.js setup",
    "manage": "node scripts/venv-python.js backend/manage.py",
    "migrate": "node scripts/venv-python.js backend/manage.py migrate",
    "dev": "npm-run-all2 --parallel dev:frontend dev:backend",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "node scripts/venv-python.js backend/manage.py runserver 0.0.0.0:8000",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend run start",
    "lint": "npm --prefix frontend run lint"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "npm-run-all2": "8.0.4"
  }
}
