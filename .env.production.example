# =============================================================================
# PRODUCTION TEMPLATE  (Django settings: drt_core.settings.production)
# =============================================================================
# How to use:
#   1. Copy this file to ".env.production" on the deploy host (or paste values
#      into your platform's secret manager). NEVER commit ".env.production".
#   2. Replace every placeholder with a real value.
#   3. drt_core/settings/production.py FAILS FAST if any required key below is
#      missing or empty (via _required(...)).
#
# For local development, see ".env.example" at the repository root.
# Ethereal (sandbox mail): create credentials at https://ethereal.email — local
# .env can use ETHEREAL_USER / ETHEREAL_PASS; production settings require the
# EMAIL_* variables below (paste the same SMTP user and password Ethereal shows).
# =============================================================================

# Django
DJANGO_SETTINGS_MODULE=drt_core.settings.production
# Use a long random value (e.g. `openssl rand -hex 64`) so `check --deploy` does not warn (security.W009).
DJANGO_SECRET_KEY=replace-with-long-random-secret
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# Optional CORS (comma-separated). Leave empty if same-origin only.
CORS_ALLOWED_ORIGINS=https://app.example.com

# Database — Django reads DATABASE_URL only in non-production settings.
DATABASE_URL=postgresql://db_user:db_password@postgres:5432/db_name

# Database - Production configuration
POSTGRES_DB=db_name
POSTGRES_USER=db_user
POSTGRES_PASSWORD=db_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SCHEMA=public
POSTGRES_CONN_MAX_AGE=600

# Redis / Celery
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
# Optional override; defaults to CELERY_BROKER_URL if unset
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Email (SMTP)
# Production settings read EMAIL_* only (not ETHEREAL_*). For sandbox / staging
# style testing you can use Ethereal (https://ethereal.email): create an account,
# copy the SMTP user and password, and paste them below. Same flow as local, but
# local maps ETHEREAL_USER / ETHEREAL_PASS in .env — here you must set the SMTP
# variables directly. Do not use Ethereal for real user-facing production mail.
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_HOST_USER=your-ethereal-smtp-user
EMAIL_HOST_PASSWORD=your-ethereal-smtp-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=DRT System <no-reply@yourapp.test>
# Optional
EMAIL_TIMEOUT=10

# GitHub datastore (required — datastore/views.py loads at import; migrate/Celery fail without it)
# Format: https://api.github.com/repos/OWNER/REPO/contents
GITHUB_API_URL=https://api.github.com/repos/your-org/your-datastore/contents
GITHUB_TOKEN=your-github-personal-access-token

# Frontend
FRONTEND_BASE_URL=https://app.example.com

# Optional security hardening
# Set >0 only after confirming HTTPS is correctly configured everywhere.
SECURE_HSTS_SECONDS=0

# Optional static/media locations (Linux/container defaults shown)
DJANGO_STATIC_ROOT=/usr/src/static/
DJANGO_MEDIA_ROOT=/usr/src/media/
