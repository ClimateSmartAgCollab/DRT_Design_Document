DJANGO_SECRET_KEY=change-me
ENVIRONMENT=development
DJANGO_DEBUG=True

# Database (PostgreSQL) — override USE_SQLITE to false when using these
USE_SQLITE=true
POSTGRES_DB=drt
POSTGRES_USER=drt
POSTGRES_PASSWORD=drt
DB_HOST=postgres
DB_PORT=5432
# DATABASE_URL=postgres://drt:drt@postgres:5432/drt

# Celery / Redis
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Email (Ethereal defaults for staging)
ETHEREAL_USER=your-ethereal-user
ETHEREAL_PASS=your-ethereal-pass

# Django management helper toggles
DJANGO_MANAGE_MIGRATE=on

# Frontend origin
FRONTEND_BASE_URL=http://127.0.0.1:3000

