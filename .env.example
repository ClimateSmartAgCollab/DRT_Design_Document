# =============================================================================
# LOCAL DEVELOPMENT TEMPLATE  (Django settings: drt_core.settings.local)
# =============================================================================
# How to use:
#   1. Copy this file to ".env" in this same folder (the repository ROOT).
#   2. Fill in real values where needed.
#   3. Never commit your ".env" file (it is gitignored).
#
# Where this file is read:
#   backend/drt_core/settings/base.py loads "<repo_root>/.env" automatically.
#   It is also injected into the docker-compose dev stack via env_file.
#
# Notes on syntax:
#   - One KEY=VALUE per line.
#   - Inline comments require a leading space:  KEY=value # comment
#   - Avoid spaces around "=" (use KEY=value, not KEY = value).
# =============================================================================


# -----------------------------------------------------------------------------
# Django core
# -----------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=drt_core.settings.local
DJANGO_DEBUG=True
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Whether entrypoint runs migrations on startup (on/off).
DJANGO_MANAGE_MIGRATE=on
# Disable HTTPS redirect for local dev (production settings would set this True).
SECURE_SSL_REDIRECT=False
# Runtime label used in logs/flows (development | staging | production).
ENVIRONMENT=development
# Optional container-start bootstrap admin. Used by backend/entrypoint.sh only.
# - If username/password are set, startup runs "createsuperuser --noinput".
# - Keep these out of committed files; set real values in local .env or deployment secrets.
# - Not required when running "python manage.py runserver" on host.
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=change-me
# DJANGO_SUPERUSER_EMAIL=admin@example.com


# -----------------------------------------------------------------------------
# Database (pick ONE runtime mode)
# -----------------------------------------------------------------------------
# Option A: SQLite (quickest local setup; no Postgres needed)
USE_SQLITE=true

# Option B: Postgres with Docker Compose (backend/celery run in containers)
# - "postgres" is the service hostname on the compose network.
# - Keep POSTGRES_* and DATABASE_URL aligned.
# - If DATABASE_URL is set, Django uses it and overrides DB_HOST/DB_PORT/POSTGRES_*.
# USE_SQLITE=false
# POSTGRES_DB=drt
# POSTGRES_USER=drt
# POSTGRES_PASSWORD=drt
# DB_HOST=postgres
# DB_PORT=5432
# DATABASE_URL=postgres://drt:drt@postgres:5432/drt

# Option C: Postgres with host Python (you run: python manage.py runserver)
# - Use this only when Django runs on your host machine, not in Docker.
# - Requires Postgres port published to host (typically 5432:5432).
# USE_SQLITE=false
# POSTGRES_DB=drt
# POSTGRES_USER=drt
# POSTGRES_PASSWORD=drt
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DATABASE_URL=postgres://drt:drt@127.0.0.1:5432/drt


# -----------------------------------------------------------------------------
# Redis / Celery
# -----------------------------------------------------------------------------
# Docker Compose mode (service hostname):
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Host Python mode (uncomment if Django runs on your host):
# REDIS_URL=redis://127.0.0.1:6379/1
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0


# -----------------------------------------------------------------------------
# Email  (Ethereal SMTP is convenient for dev; create an account at ethereal.email)
# -----------------------------------------------------------------------------
ETHEREAL_USER=your-ethereal-user
ETHEREAL_PASS=your-ethereal-pass
# Optional explicit overrides:
# EMAIL_HOST=smtp.ethereal.email
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=no-reply@yourapp.test

# Sandbox/testing UI — when True, the homepage shows the testing banner and
# sandbox credentials (served via GET /drt/public-config/). Set False in production.
TESTING_MODE=true
OWNER_EMAIL=owner@drt.ca


# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
FRONTEND_BASE_URL=http://127.0.0.1:3000


# -----------------------------------------------------------------------------
# Datastore (ContextHub by default; GitHub is rollback only)
# -----------------------------------------------------------------------------
# contexthub | github
DATASTORE_BACKEND=contexthub
# ContextHub backend origin (not the DRT frontend)
CONTEXT_HUB_URL=http://localhost:4000
# Must match ContextHub DRT_API_KEY
CONTEXT_HUB_API_KEY=your-drt-api-key

# GitHub rollback (only when DATASTORE_BACKEND=github)
# Format: https://api.github.com/repos/OWNER/REPO/contents
GITHUB_API_URL=https://api.github.com/repos/your-org/your-datastore/contents
GITHUB_TOKEN=your-github-personal-access-token


# -----------------------------------------------------------------------------
# Admin
# -----------------------------------------------------------------------------
ADMIN_ENABLED=true
# Comma-separated list.
ADMIN_EMAILS=admin@example.com

# -----------------------------------------------------------------------------
# GitHub webhook
# -----------------------------------------------------------------------------
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret