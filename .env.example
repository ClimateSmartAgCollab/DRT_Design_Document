# =============================================================================
# DRT environment catalog
# =============================================================================
# One template. Copy it, then fill values for that host. Do not reuse secrets
# across hosts (SMTP, DB, catalogue API key, GitHub, DJANGO_SECRET_KEY).
#
#   Local:     copy to .env
#               DJANGO_SETTINGS_MODULE=drt_core.settings.local
#               Django loads this file automatically.
#
#   Remote:     copy to .env.production  (drt-test and a future prod host)
#               Compose always injects that file. Same Django settings module
#               (drt_core.settings.production). Staging vs production is values:
#                 drt-test:  TESTING_MODE=true,  ENVIRONMENT=staging, sandbox SMTP
#                 prod host: TESTING_MODE=false, ENVIRONMENT=production, real SMTP
#
# Never commit .env or .env.production.
#
# Frontend API URL is not in this file. Copy frontend/env.local.example to
# frontend/.env.local (laptop: NEXT_PUBLIC_API_URL=http://127.0.0.1:8000).
# On a remote host nginx same-origin is enough; NEXT_PUBLIC_API_URL is optional.
#
# Syntax: KEY=value  (inline comments need a space: VALUE # comment)
# =============================================================================


# -----------------------------------------------------------------------------
# Django
# -----------------------------------------------------------------------------
# Local: drt_core.settings.local
# Remote: drt_core.settings.production
DJANGO_SETTINGS_MODULE=drt_core.settings.local
DJANGO_DEBUG=True
# openssl rand -hex 64   (required and unique on every host)
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_MANAGE_MIGRATE=on
# Local only. Production settings force HTTPS redirect and ignore this key.
SECURE_SSL_REDIRECT=False
# development | staging | production  (log label only)
ENVIRONMENT=development
# Homepage banner + GET /drt/public-config/. Must be false on real production.
TESTING_MODE=true
# Optional. Default 10080 (7 days).
# MAGIC_LINK_TTL_MINUTES=10080
# Remote only (production settings require these):
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=drt-test.canadacentral.cloudapp.azure.com
# CSRF_TRUSTED_ORIGINS=https://drt-test.canadacentral.cloudapp.azure.com
# CORS_ALLOWED_ORIGINS=https://drt-test.canadacentral.cloudapp.azure.com
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=change-me
# DJANGO_SUPERUSER_EMAIL=admin@example.com


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# local:
USE_SQLITE=false
POSTGRES_DB=drt
POSTGRES_USER=drt
POSTGRES_PASSWORD=drt
DB_HOST=127.0.0.1
DB_PORT=5433
DATABASE_URL=postgres://drt:drt@127.0.0.1:5433/drt

# Remote Compose (hostnames on the compose network). Production settings
# read POSTGRES_* (not DATABASE_URL / DB_HOST).
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# POSTGRES_SCHEMA=public
# POSTGRES_CONN_MAX_AGE=600


# -----------------------------------------------------------------------------
# Redis (Django cache + magic-link tokens)
# -----------------------------------------------------------------------------
# local:
REDIS_URL=redis://127.0.0.1:6380/1
# Remote Compose:
# REDIS_URL=redis://redis:6379/1


# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
# Local Mailpit (SMTP has no authentication):
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=DRT System <no-reply@drt.local>
TESTING_INBOX_URL=http://127.0.0.1:8025
OWNER_EMAIL=owner@drt.ca
EMAIL_TIMEOUT=10

# Remote: production settings require EMAIL_*.
# Staging: authenticated Mailpit. Production: real SMTP — never staging keys.
# When TESTING_MODE=true, keep OWNER_EMAIL set (homepage tester card).
# MP_SMTP_AUTH is user:password for the Mailpit container; it must match
# EMAIL_HOST_USER and EMAIL_HOST_PASSWORD. Do not put a catalogue
# MAILGUN_API_KEY here — DRT sends via SMTP only.
# EMAIL_HOST=mailpit
# EMAIL_PORT=1025
# EMAIL_HOST_USER=drt
# EMAIL_HOST_PASSWORD=change-me
# MP_SMTP_AUTH=drt:change-me
# EMAIL_USE_TLS=False
# DEFAULT_FROM_EMAIL=DRT System <no-reply@drt.local>
# TESTING_INBOX_URL=/mailpit


# -----------------------------------------------------------------------------
# Frontend / public URL
# -----------------------------------------------------------------------------
# Deep links in emails and the URL a catalogue should mint:
#   {FRONTEND_BASE_URL}/negotiation/generate/{linkUuid}
FRONTEND_BASE_URL=http://127.0.0.1:3001
# Remote:
# FRONTEND_BASE_URL=https://drt-test.canadacentral.cloudapp.azure.com


# -----------------------------------------------------------------------------
# Datastore
# -----------------------------------------------------------------------------
# Default: HTTP catalogue (the ContextHub-shaped contract). DRT GETs
# /api/v1/drt/* with header X-DRT-API-KEY. Point CONTEXT_HUB_URL at any
# origin that implements that surface (ContextHub, Genovalia, …).
# GitHub CSVs are rollback only. GITHUB_* are not required at Django import
# and migrate does not fail if they are unset.
DATASTORE_BACKEND=contexthub
# Catalogue API origin (no /api/v1/drt suffix). Local ContextHub is typically :3000.
CONTEXT_HUB_URL=http://localhost:3000
# v1 shared secret. Must match the catalogue DRT_API_KEY. Header: X-DRT-API-KEY.
# Not a Keycloak client secret. Rotate by updating both services together.
CONTEXT_HUB_API_KEY=your-drt-api-key

# Rollback only — set DATASTORE_BACKEND=github and fill these:
# GITHUB_API_URL=https://api.github.com/repos/your-org/your-datastore/contents
# GITHUB_TOKEN=your-github-personal-access-token
# GITHUB_WEBHOOK_SECRET=your-github-webhook-secret


# -----------------------------------------------------------------------------
# Admin (DRT magic-link admin, not Django /django-admin/)
# -----------------------------------------------------------------------------
# ADMIN_ENABLED defaults to false if omitted. ADMIN_EMAILS is a comma-separated
# allowlist (case-sensitive as stored).
ADMIN_ENABLED=true
ADMIN_EMAILS=admin@example.com


# -----------------------------------------------------------------------------
# Remote-only optional
# -----------------------------------------------------------------------------
# SECURE_HSTS_SECONDS=0
# DJANGO_STATIC_ROOT=/usr/src/static/
# DJANGO_MEDIA_ROOT=/usr/src/media/
# CRON_HEALTHCHECK_ABANDONMENT_URL=https://hc-ping.com/your-abandonment-uuid
# CRON_HEALTHCHECK_CACHE_URL=https://hc-ping.com/your-cache-uuid
