[Unit]
Description=DRT production stack (Docker Compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/azureuser/DRT_Design_Document/infra
# Run as a user in the docker group (not root); change User= to your deploy user.
User=azureuser
Group=azureuser
ExecStart=/usr/bin/docker-compose -f docker-compose.prod.yml --env-file ../.env.production up -d --build
# Use `stop` (not `down`) so volumes/networks are not removed on service stop.
ExecStop=/usr/bin/docker-compose -f docker-compose.prod.yml --env-file ../.env.production stop -t 60
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
